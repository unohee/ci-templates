# Pinned scanner versions and checksums for security/bootstrap.sh.
#
# GitHub Advanced Security (code scanning, secret scanning) and Code Quality are
# being dropped on 2026-11-20 for cost. The replacements below are the free,
# license-clean tools: none of them require a paid GitHub licence and all of them
# run on a laptop and on the self-hosted runners.
#
# This file is data, not a script: bootstrap.sh sources it. Every version is
# pinned and every download is verified against the checksum here, so a silent
# upstream change cannot enter CI.
#
# Why not CodeQL: the GitHub CodeQL Terms and Conditions ship with the CLI
# (.local/opt/codeql/LICENSE.md). Without a paid GitHub Advanced Security licence
# they authorise analysis only of codebases released under an OSI-approved
# licence, and they forbid generating a CodeQL database "for or during automated
# analysis, CI or CD". Every Intrect repository is private, so the CodeQL CLI may
# not run there once the GHAS subscription ends.

# gitleaks: secret scanning (MIT). Replaces GitHub secret scanning + push
# protection. Single static binary.
GITLEAKS_VERSION=8.30.1
GITLEAKS_LINUX_X64_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
GITLEAKS_DARWIN_ARM64_SHA256=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5

# osv-scanner: dependency vulnerabilities from lockfiles (Apache-2.0). Replaces
# Dependabot alerts across every ecosystem in one pass.
OSV_SCANNER_VERSION=2.7.1
OSV_SCANNER_LINUX_AMD64_SHA256=fb7dab19a8bd9bbe5c3189f09d4b7ee1820c9553a23bac202648a56efd2f6ee8
OSV_SCANNER_DARWIN_ARM64_SHA256=b22c02877a811c8f78956e8643efa554932b7378f590d13f8e97d4e9448a29f3

# semgrep: static analysis (engine LGPL-2.1; the registry rules it fetches are
# under the Semgrep Rules License, which permits internal business use). Replaces
# CodeQL code scanning. Installed into a virtualenv because it is a Python tool.
SEMGREP_VERSION=1.186.0
# semgrep fetches rules from the registry at run time; the pinned --config values
# live in scan.sh.
SEMGREP_CONFIGS="p/default"

# lizard: cyclomatic complexity and copy/paste detection (MIT). Replaces the
# maintainability half of GitHub Code Quality. Report-only until a baseline
# exists (see security/README.md).
LIZARD_VERSION=1.26.1
